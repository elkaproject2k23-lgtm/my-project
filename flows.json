        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Cek Status",
        "func": "var deviceStatus = global.get('deviceStatus');\n\n// Hanya lanjut jika alat aktif\nif (deviceStatus === 'Aktif') {\n    return msg;\n}\n\n// Jika mati, diam saja\nreturn null;",
