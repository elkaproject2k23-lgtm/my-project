    {
        "id": "db4f32d4d4b65310",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Status",
        "func": "var db = parseFloat(msg.payload.dB);\nvar status;\n\nif (db < 30) {\n    status = \"Tidak Aktif\";\n} else if (db >= 30 && db <= 70) {\n    status = \"Aktif Normal\";\n} else {\n    status = \"Aktif Bising\";\n}\n\n// Simpan status ke global\nglobal.set('status', status);\nglobal.set('db', db);\n\nmsg.payload = status;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
