    {
        "id": "9921894b29c7575b",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Siapkan Data",
        "func": "let db     = global.get('db') || 0;\nlet status = global.get('status') || 'Tidak Aktif';\nlet min    = global.get('min') || 0;\nlet avg    = global.get('avg') || 0;\nlet max    = global.get('max') || 0;\n\nlet waktu = new Date().toLocaleString('id-ID', {\n    timeZone: 'Asia/Makassar'\n});\n\nmsg.payload = [[waktu, db, status, min, avg, max]];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 420,
        "wires": [
            [
                "99e4e8fdde4ba64d"
            ]
        ]
    },
    {
        "id": "32a2ccd28f7ca26a",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Reset Data",
        "func": "// Reset semua nilai untuk periode berikutnya\nglobal.set('min', 0);\nglobal.set('avg', 0);\nglobal.set('max', 0);\nglobal.set('db', 0);\nglobal.set('status', 'Tidak Aktif');\n\n// Reset context di node Cek Min, Hitung Avg, Cek Max\nflow.set('min', undefined);\nflow.set('sum', undefined);\nflow.set('count', undefined);\nflow.set('max', undefined);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 930,
        "y": 420,
        "wires": [
            []
        ]
    },
