    {
        "id": "9d476bdecd496a2b",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Cek Max",
        "func": "let max = context.get('max');\nlet val = parseFloat(msg.payload.dB);\n\nif (!isNaN(val)) {\n    if (max === undefined || val > max) {\n        max = val;\n        context.set('max', max);\n    }\n}\n\nmsg.payload = max !== undefined ? parseFloat(max.toFixed(1)) : 0;\nglobal.set('max', msg.payload);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 540,
        "wires": [
            [
                "8847eb068a53642a"
            ]
        ]
    },
    {
        "id": "e00ee5fe2ee3571a",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Hitung Avg",
        "func": "let sum = context.get('sum') || 0;\nlet count = context.get('count') || 0;\nlet val = parseFloat(msg.payload.dB);\n\nif (!isNaN(val)) {\n    sum += val;\n    count += 1;\n    context.set('sum', sum);\n    context.set('count', count);\n}\n\nmsg.payload = count > 0 ? parseFloat((sum / count).toFixed(1)) : 0;\nglobal.set('avg', msg.payload);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 480,
        "wires": [
            [
                "f6ccc2f582aefd99"
            ]
        ]
    },
    {
        "id": "08d62671bfde60bd",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Cek Min",
        "func": "let min = context.get('min');\nlet val = parseFloat(msg.payload.dB);\n\nif (!isNaN(val) && val > 0) {\n    if (min === undefined || val < min) {\n        min = val;\n        context.set('min', min);\n    }\n}\n\nmsg.payload = min !== undefined ? parseFloat(min.toFixed(1)) : 0;\nglobal.set('min', msg.payload);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 420,
        "wires": [
