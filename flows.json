                "99e4e8fdde4ba64d"
            ]
        ]
    },
    {
        "id": "32a2ccd28f7ca26a",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Reset Data",
        "func": "// Reset semua nilai untuk periode berikutnya\nglobal.set('min', 0);\nglobal.set('avg', 0);\nglobal.set('max', 0);\nglobal.set('db', 0);\n\n// Reset context di node Cek Min, Hitung Avg, Cek Max\nflow.set('min', undefined);\nflow.set('sum', undefined);\nflow.set('count', undefined);\nflow.set('max', undefined);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
