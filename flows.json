    {
        "id": "9d476bdecd496a2b",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Cek Max",
        "func": "// Ambil nilai max yang tersimpan\nlet max = context.get('max');\n\nlet val = parseFloat(msg.payload);\nif (!isNaN(val)) {\n    // Update max jika nilai baru lebih besar\n    if (max === undefined || val > max) {\n        max = val;\n        context.set('max', max);\n    }\n}\n\n// Kirim nilai max, jika belum ada kirim 0\nmsg.payload = max !== undefined ? parseFloat(max.toFixed(1)) : 0;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 420,
        "wires": [
            [
                "8847eb068a53642a"
            ]
        ]
    },
    {
        "id": "e00ee5fe2ee3571a",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Hitung Avg",
        "func": "// Ambil nilai sum dan count yang tersimpan\nlet sum = context.get('sum') || 0;\nlet count = context.get('count') || 0;\n\nlet val = parseFloat(msg.payload);\n\n// Hanya proses jika nilai valid\nif (!isNaN(val)) {\n    sum += val;\n    count += 1;\n    context.set('sum', sum);\n    context.set('count', count);\n}\n\n// Hitung rata-rata, kalau belum ada data kirim 0\nmsg.payload = count > 0 ? parseFloat((sum / count).toFixed(1)) : 0;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 360,
        "wires": [
            [
                "f6ccc2f582aefd99"
            ]
        ]
    },
    {
        "id": "08d62671bfde60bd",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Cek Min",
        "func": "// Ambil nilai min yang tersimpan\nlet min = context.get('min');\n\nlet val = parseFloat(msg.payload);\n\nif (!isNaN(val) && val > 0) {\n    // Update min jika nilai baru lebih kecil atau belum ada data\n    if (min === undefined || val < min) {\n        min = val;\n        context.set('min', min);\n    }\n}\n\n// Kirim nilai min, jika belum ada kirim 0\nmsg.payload = min !== undefined ? parseFloat(min.toFixed(1)) : 0;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 300,
        "wires": [
            [
                "072f5f3a092fa7ea"
            ]
        ]
    },
    {
        "id": "da740d4e77854e11",
        "type": "function",
        "z": "4e87f9af348f71da",
        "name": "Ambil dB",
        "func": "// Ambil nilai dB dari Firebase\nmsg.payload = Math.round(msg.payload.dB * 10) / 10;\nreturn msg;",
