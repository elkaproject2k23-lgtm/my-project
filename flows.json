        "func": "// Simpan semua nilai ke msg terpisah\nmsg.db     = msg.payload.dB;\nmsg.status = msg.payload.status;\nmsg.min    = msg.payload.min;\nmsg.avg    = msg.payload.avg;\nmsg.max    = msg.payload.max;\n\n// Simpan ke global untuk Siapkan Data\nglobal.set('db', msg.db);\nglobal.set('status', msg.status);\nglobal.set('min', msg.min);\nglobal.set('avg', msg.avg);\nglobal.set('max', msg.max);\n\n// Teruskan dB untuk gauge dan grafik\nmsg.payload = msg.payload.dB;\nreturn msg;",
